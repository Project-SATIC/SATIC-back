{
  "name": "satic-back-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Porte do SATIC-back (Java) para TypeScript: parser SIGAA, validador RN-01..RN-04 e motor StateSpaceSearch.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "motor": "node tools/rodar-motor.ts",
    "migrate": "node src/db/run-migrations.ts",
    "migrate:reset": "node src/db/run-migrations.ts --reset",
    "db:seed": "node src/seed/db-seeder.ts",
    "start": "node src/api/server.ts",
    "dev": "node --watch src/api/server.ts",
    "local": "node tools/banco-local.ts --com-api",
    "db:local": "node tools/banco-local.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
