{
  "name": "satic-back-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end do SATIC em TypeScript + Express + PostgreSQL: parser SIGAA, validador RN-01..RN-04, motor StateSpaceSearch e motor de sugestões.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types test/integration/run-pg-integration.ts",
    "typecheck": "tsc --noEmit",
    "motor": "node --experimental-strip-types tools/rodar-motor.ts",
    "migrate": "node --experimental-strip-types src/db/run-migrations.ts",
    "migrate:reset": "node --experimental-strip-types src/db/run-migrations.ts --reset",
    "db:seed": "node --experimental-strip-types src/seed/db-seeder.ts",
    "start": "node --experimental-strip-types src/api/server.ts",
    "dev": "node --experimental-strip-types --watch src/api/server.ts",
    "local": "node --experimental-strip-types tools/banco-local.ts --com-api",
    "db:local": "node --experimental-strip-types tools/banco-local.ts",
    "local:amostra": "node --experimental-strip-types tools/banco-local.ts --com-api --amostra"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
