# Configurações do PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=satic

# Ou alternativamente via URL de conexão:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satic

# Porta da API (padrão 3001)
# PORT=3001

# Origens aceitas pelo CORS, separadas por vírgula (sem a variável, aceita qualquer origem)
# CORS_ORIGIN=http://127.0.0.1:8040,http://localhost:8040

# Tamanho do pool de conexões (padrão 10)
# PGPOOL_MAX=10

# Nível de log estruturado JSON: debug | info | warn | error | silent (padrão info)
# LOG_LEVEL=info

# Executa migrations e seed inicial automaticamente ao subir o servidor (usado no Docker)
# AUTO_MIGRATE=true
# AUTO_SEED=true
